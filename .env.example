# InvestInsight India - Environment Variables Configuration
# Copy this file to .env and fill in the values to enable live data integration.

# Selected stock data API provider. Options: 'ALPHA_VANTAGE', 'YAHOO_FINANCE', 'DEMO'
VITE_DATA_PROVIDER=DEMO

# AlphaVantage API Key (https://www.alphavantage.co/)
VITE_ALPHA_VANTAGE_API_KEY=

# Finnhub API Key (https://finnhub.io/) for live financial headlines
VITE_FINNHUB_API_KEY=

# Supabase Configurations (for future PostgreSQL database storage of Watchlists/User profiles)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Authentication (from Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
